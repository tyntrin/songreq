# Public base URL of the app (used for QR codes and auth callbacks)
APP_URL=http://localhost:3200
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/song_request
# Auth.js secret (generate: npx auth secret)
AUTH_SECRET=
# Dev-only credentials login. Ignored/impossible when NODE_ENV=production
AUTH_DEV_LOGIN=true
# LINE Login provider
AUTH_LINE_ID=
AUTH_LINE_SECRET=
# Google provider
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed as admins
ADMIN_EMAILS=
# Image storage driver: local | r2
STORAGE_DRIVER=local
# Cloudflare R2 (only when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
